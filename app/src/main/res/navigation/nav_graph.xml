<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment android:id="@+id/homeFragment"
        android:name="com.storagecleaner.ui.home.HomeFragment"
        android:label="Dashboard" tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_folderPicker" app:destination="@id/folderPickerFragment"
            app:enterAnim="@anim/slide_in_right" app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left" app:popExitAnim="@anim/slide_out_right"/>
        <action android:id="@+id/action_home_to_archive" app:destination="@id/archiveFragment"/>
        <action android:id="@+id/action_home_to_scanHistory" app:destination="@id/scanHistoryFragment"/>
        <action android:id="@+id/action_home_to_analytics" app:destination="@id/storageAnalyticsFragment"/>
    </fragment>

    <fragment android:id="@+id/folderPickerFragment"
        android:name="com.storagecleaner.ui.folders.FolderPickerFragment"
        android:label="Scan" tools:layout="@layout/fragment_folder_picker">
        <action android:id="@+id/action_folderPicker_to_preview" app:destination="@id/filePreviewFragment"
            app:enterAnim="@anim/slide_in_right" app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left" app:popExitAnim="@anim/slide_out_right"/>
        <action android:id="@+id/action_folderPicker_to_comparison" app:destination="@id/comparisonFragment"
            app:enterAnim="@anim/slide_in_right" app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left" app:popExitAnim="@anim/slide_out_right"/>
        <action android:id="@+id/action_folderPicker_to_archive" app:destination="@id/archiveFragment"/>
    </fragment>

    <fragment android:id="@+id/filePreviewFragment"
        android:name="com.storagecleaner.ui.preview.FilePreviewFragment"
        android:label="File Preview" tools:layout="@layout/fragment_file_preview">
        <argument android:name="file" app:argType="com.storagecleaner.data.model.ScannedFile"/>
    </fragment>

    <fragment android:id="@+id/comparisonFragment"
        android:name="com.storagecleaner.ui.duplicates.ComparisonFragment"
        android:label="Compare" tools:layout="@layout/fragment_comparison">
        <argument android:name="fileA" app:argType="com.storagecleaner.data.model.ScannedFile"/>
        <argument android:name="fileB" app:argType="com.storagecleaner.data.model.ScannedFile"/>
        <argument android:name="similarityPct" app:argType="integer" android:defaultValue="0"/>
    </fragment>

    <fragment android:id="@+id/archiveFragment"
        android:name="com.storagecleaner.ui.archive.ArchiveFragment"
        android:label="Archive" tools:layout="@layout/fragment_archive"/>

    <fragment android:id="@+id/settingsFragment"
        android:name="com.storagecleaner.ui.settings.SettingsFragment"
        android:label="Settings" tools:layout="@layout/fragment_settings">
        <action android:id="@+id/action_settings_to_protectedFiles" app:destination="@id/protectedFilesFragment"
            app:enterAnim="@anim/slide_in_right" app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left" app:popExitAnim="@anim/slide_out_right"/>
    </fragment>

    <fragment android:id="@+id/protectedFilesFragment"
        android:name="com.storagecleaner.ui.protected_files.ProtectedFilesFragment"
        android:label="Protected Files" tools:layout="@layout/fragment_protected_files"/>

    <fragment android:id="@+id/scanHistoryFragment"
        android:name="com.storagecleaner.ui.home.ScanHistoryFragment"
        android:label="Scan History" tools:layout="@layout/fragment_scan_history"/>

    <fragment android:id="@+id/storageAnalyticsFragment"
        android:name="com.storagecleaner.ui.home.StorageAnalyticsFragment"
        android:label="Storage Analytics" tools:layout="@layout/fragment_storage_analytics"/>

</navigation>
