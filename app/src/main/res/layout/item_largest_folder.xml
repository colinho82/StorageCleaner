<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@color/surface"
    android:paddingHorizontal="12dp" android:paddingVertical="10dp"
    android:gravity="center_vertical">

    <TextView android:id="@+id/tvRank"
        android:layout_width="28dp" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/text_secondary" android:gravity="center"
        tools:text="1"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="6dp">
        <TextView android:id="@+id/tvFolderName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="middle"
            tools:text="📁 Camera"/>
        <TextView android:id="@+id/tvFolderPath"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="@color/text_secondary"
            android:maxLines="1" android:ellipsize="start"
            tools:text="/storage/emulated/0/DCIM/Camera"/>
    </LinearLayout>

    <TextView android:id="@+id/tvFolderMeta"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/primary"
        android:layout_marginStart="6dp" android:gravity="end"
        tools:text="1.2 GB · 340 files"/>

</LinearLayout>
