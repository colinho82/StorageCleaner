<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@color/surface"
    android:paddingHorizontal="12dp" android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <CheckBox android:id="@+id/cbSelect"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"/>

    <ImageView android:id="@+id/ivThumbnail"
        android:layout_width="48dp" android:layout_height="48dp"
        android:scaleType="centerCrop" android:background="@color/surface_variant"
        android:contentDescription="@null"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvFileName"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="middle"
                tools:text="IMG_20260428_142315.jpg"/>
            <TextView android:id="@+id/tvOrigCopyBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="6dp" android:paddingVertical="1dp"
                android:textSize="9sp" android:textColor="@android:color/white" android:textStyle="bold"
                tools:text="KEEP"/>
        </LinearLayout>
        <TextView android:id="@+id/tvFileDetails"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/text_secondary"
            tools:text="4.2 MB · 4032×3024 · 28 Apr 2026"/>
        <TextView android:id="@+id/tvFilePath"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="@color/text_secondary"
            android:maxLines="1" android:ellipsize="start"
            tools:text="/storage/emulated/0/DCIM/Camera/IMG_20260428_142315.jpg"/>
    </LinearLayout>

    <ImageView android:id="@+id/btnProtect"
        android:layout_width="32dp" android:layout_height="32dp"
        android:padding="6dp" android:src="@drawable/ic_shield"
        android:layout_marginStart="6dp" android:contentDescription="Protect file"/>

</LinearLayout>
