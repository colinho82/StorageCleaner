<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@color/surface"
    android:paddingHorizontal="12dp" android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <ImageView android:id="@+id/ivThumbnail"
        android:layout_width="44dp" android:layout_height="44dp"
        android:scaleType="centerCrop" android:background="@color/surface_variant"
        android:contentDescription="@null"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp">
        <TextView android:id="@+id/tvFileName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="middle"
            tools:text="IMG_20260428_142315.jpg"/>
        <TextView android:id="@+id/tvFileDetails"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/text_secondary"
            tools:text="4.2 MB · Archived 14 Jun 2026, 10:30"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRestore"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="↩️" android:textSize="14sp"
        android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
        android:paddingHorizontal="8dp" app:cornerRadius="10dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemove"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="🗑️" android:textSize="14sp"
        android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
        android:paddingHorizontal="8dp" app:cornerRadius="10dp"/>

</LinearLayout>
