<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="280dp"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/surface_variant"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView android:id="@+id/ivPreview"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerInside" android:contentDescription="@null"
                    android:visibility="gone"/>
                <ImageView android:id="@+id/ivIcon"
                    android:layout_width="96dp" android:layout_height="96dp"
                    android:layout_gravity="center" android:contentDescription="@null"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/tvFileName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="17sp" android:textStyle="bold"
            tools:text="IMG_20260428_142315.jpg"/>

        <TextView android:id="@+id/tvFileDetails"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="@color/text_secondary"
            tools:text="4.2 MB · 4032×3024 · Modified 28 Apr 2026, 14:23"/>

        <TextView android:id="@+id/tvMimeType"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/text_secondary"
            tools:text="image/jpeg"/>

        <TextView android:id="@+id/tvFilePath"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/text_secondary"
            tools:text="/storage/emulated/0/DCIM/Camera/IMG_20260428_142315.jpg"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="20dp" android:text="📂 Open with…" app:cornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="📤 Share"
            app:cornerRadius="12dp" xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProtect"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:text="🛡️ Mark as Protected"
            app:cornerRadius="12dp" xmlns:app="http://schemas.android.com/apk/res-auto"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
