<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@color/surface"
    android:paddingHorizontal="12dp" android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <TextView android:id="@+id/tvRank"
        android:layout_width="28dp" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/text_secondary" android:gravity="center"
        tools:text="1"/>

    <ImageView android:id="@+id/ivIcon"
        android:layout_width="40dp" android:layout_height="40dp"
        android:padding="8dp" android:background="@color/surface_variant"
        android:contentDescription="@null"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="10dp">
        <TextView android:id="@+id/tvFileName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="middle"
            tools:text="VID_20260601_120000.mp4"/>
        <TextView android:id="@+id/tvFilePath"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="@color/text_secondary"
            android:maxLines="1" android:ellipsize="start"
            tools:text="/storage/emulated/0/DCIM/Camera/VID_20260601_120000.mp4"/>
    </LinearLayout>

    <TextView android:id="@+id/tvFileSize"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/primary"
        android:layout_marginStart="6dp"
        tools:text="245 MB"/>

</LinearLayout>
